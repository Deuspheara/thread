{
  "name": "thread-decision-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "node --import tsx --test --test-timeout=15000 test/*.test.ts",
    "start": "node dist/main.js",
    "check-provider": "node dist/check-provider.js",
    "benchmark": "node --import tsx test/benchmark.ts"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "6.1.0",
    "fastify": "5.12.5",
    "redis": "6.2.1",
    "typebox": "1.3.34",
    "undici": "8.11.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
