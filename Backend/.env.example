# Copy to thread-api.env, chmod 600, and fill privately. Never put these keys in Thread.app.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=typesafe/jev-1.13
# JSON map of client name to independent random base64url Thread token (32-128 chars).
# Generate a token with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Then set, for example: THREAD_CLIENT_TOKENS='{"poc":"YOUR_GENERATED_TOKEN"}'
THREAD_CLIENT_TOKENS='{}'
THREAD_API_PORT=8787

# Compose overrides this with its private rate-store address.
THREAD_REDIS_URL=redis://127.0.0.1:6379/0
