{
  "manifest_version": 3,
  "name": "Thread Context",
  "version": "0.1.0",
  "description": "Share normal browser tab metadata with the local Thread app.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Reconnect Thread"
  }
}
